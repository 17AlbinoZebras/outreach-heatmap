{
  "name": "patient-heatmap",
  "version": "0.1.0",
  "description": "Patient referral heatmap",
  "author": "Amanda Robinson",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "electron:preview": "next build && electron .",
    "electron:dist": "next build && electron-builder"
  },
  "build": {
    "appId": "com.patient-heatmap",
    "productName": "Patient Heatmap",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**",
      "electron/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "src/app/icon.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "src/app/icon.png"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "dependencies": {
    "@fontsource/arimo": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.0",
    "@fortawesome/fontawesome-svg-core": "^7.3.0",
    "@fortawesome/free-brands-svg-icons": "^7.3.0",
    "@fortawesome/free-regular-svg-icons": "^7.3.0",
    "@fortawesome/free-solid-svg-icons": "^7.3.0",
    "@fortawesome/react-fontawesome": "^3.4.0",
    "@tailwindcss/vite": "^4.3.1",
    "@turf/boolean-point-in-polygon": "^7.3.5",
    "@turf/helpers": "^7.3.5",
    "leaflet": "^1.9.4",
    "leaflet-defaulticon-compatibility": "^0.1.2",
    "leaflet.markercluster": "^1.5.3",
    "next": "16.2.9",
    "radix-ui": "^1.6.2",
    "react": "^19.0.0-rc.1",
    "react-dom": "^19.0.0-rc.1",
    "react-leaflet": "^5.0.0-rc.2",
    "react-leaflet-markercluster": "^5.0.0-rc.0",
    "react-tooltip": "^6.0.8",
    "tailwindcss": "^4.3.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^32.3.3",
    "electron-builder": "^25.1.8",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "typescript": "^5"
  }
}
